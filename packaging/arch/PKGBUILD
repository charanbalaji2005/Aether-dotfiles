# Maintainer: Neelampalli Charan Balaji <neelampallicharanbalaji14@gmail.com>
#
# STATUS: the package() function is exercised by tests/packaging/test_packages.sh
# (run with bash against the real release tarball); a real `makepkg`/`namcap`
# run on Arch has NOT been performed — see TEST_REPORT.md. AetherOS targets
# Fedora; this PKGBUILD is community-grade.
#
# sha256sums is filled from the exact release tarball by
# tools/update-pkgbuild.sh (the release workflow does this and publishes the
# result). The placeholder below makes makepkg fail loudly — it never skips
# verification.

pkgname=aetheros-dotfiles
_upstreamver=1.0.0
pkgver=1.0.0
pkgrel=1
pkgdesc="AetherOS Hyprland desktop: Quickshell shell, configs and tools"
arch=('any')
url="https://github.com/charanbalaji2005/Aether-dotfiles"
license=('GPL-3.0-or-later')
depends=('hyprland' 'python' 'kitty' 'zsh' 'bash')
optdepends=('quickshell: the aether (Quickshell) interface'
            'waybar: classic interface bar'
            'rofi-wayland: classic interface launcher and menus'
            'swaync: classic interface notifications'
            'swww: classic interface wallpapers'
            'hyprlock: lock screen'
            'wlogout: classic interface power menu'
            'hypridle: idle locking and dimming'
            'pciutils: GPU model names'
            'vulkan-tools: aether render --probe'
            'libva-utils: VA-API checks'
            'hyprsunset: night light'
            'power-profiles-daemon: power modes'
            'imagemagick: accent from wallpaper'
            'libsecret: assistant API keys in the keyring'
            'cliphist: clipboard history'
            'wf-recorder: screen recording')
source=("$url/releases/download/v$_upstreamver/$pkgname-$_upstreamver.tar.gz")
sha256sums=('FILLED_BY_tools/update-pkgbuild.sh')

package() {
    local src="$srcdir/$pkgname-$_upstreamver"
    install -dm755 "$pkgdir/usr/share/$pkgname"
    cp -a "$src/." "$pkgdir/usr/share/$pkgname/"
    rm -rf "$pkgdir/usr/share/$pkgname/.github" "$pkgdir/usr/share/$pkgname/tests" "$pkgdir/usr/share/$pkgname/packaging"
    rm -f "$pkgdir/usr/share/$pkgname/.editorconfig" "$pkgdir/usr/share/$pkgname/.gitattributes" "$pkgdir/usr/share/$pkgname/.shellcheckrc"
    find "$pkgdir/usr/share/$pkgname" -name ".gitignore" -delete
    chmod 0755 "$pkgdir/usr/share/$pkgname/install.sh" "$pkgdir/usr/share/$pkgname"/scripts/*.sh "$pkgdir/usr/share/$pkgname"/scripts/bin/*

    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/share/$pkgname/scripts/setup-symlinks.sh" "$pkgdir/usr/bin/aetheros-dotfiles-setup"
    ln -s "/usr/share/$pkgname/scripts/doctor.sh" "$pkgdir/usr/bin/aetheros-dotfiles-doctor"
    ln -s "/usr/share/$pkgname/scripts/bin/aether" "$pkgdir/usr/bin/aether"
    ln -s "/usr/share/$pkgname/scripts/bin/aether-screenshot" "$pkgdir/usr/bin/aether-screenshot"
    ln -s "/usr/share/$pkgname/scripts/bin/aether-wallpaper" "$pkgdir/usr/bin/aether-wallpaper"

    install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
