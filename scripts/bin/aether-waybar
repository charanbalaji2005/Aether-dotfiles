#!/usr/bin/bash
# aether-waybar — run and switch Waybar for the AetherOS classic interface.
#
#   aether-waybar start | restart | stop | toggle (hide/show)
#   aether-waybar layout NAME     use ~/.config/waybar/layouts/NAME.jsonc
#   aether-waybar style NAME      use ~/.config/waybar/styles/NAME.css
#   aether-waybar layouts | styles
#
# Waybar is always started with explicit -c/-s: the style is a small file
# generated by aether-colors that imports the palette and the chosen style.

set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib/classic.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/classic.sh"

WB="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
NAME_RE='^[a-z0-9][a-z0-9_-]*$'

names() { find -L "$WB/$1" -maxdepth 1 -type f -name "[!_]*.$2" -printf '%f\n' 2>/dev/null | sed "s/\.$2\$//" | sort; }

layout_file() {
    local l; l="$(cstate_get waybar_layout default)"
    [ -f "$WB/layouts/$l.jsonc" ] || l=default
    echo "$WB/layouts/$l.jsonc"
}

start() {
    need waybar waybar
    pgrep -x waybar >/dev/null && return 0
    [ -f "$CLASSIC_DIR/waybar/style.css" ] || aether-colors init >/dev/null || true
    # Layouts with a dock include its generated modules.
    [ -f "$CLASSIC_DIR/waybar/dock-modules.jsonc" ] || aether-dock generate >/dev/null 2>&1 || true
    local style="$CLASSIC_DIR/waybar/style.css"
    [ -f "$style" ] || style="$WB/style.css"
    mkdir -p "$CLASSIC_RUNTIME"
    setsid -f "$SELF" _run main "$(layout_file)" "$style"
    # A look may have an island: a second Waybar that starts hidden and is shown
    # by aether-island only while it has something to show.
    # The default island is the Quickshell Dynamic Island (scripts/dynamic-island.sh);
    # island_engine=waybar, or no Quickshell, falls back to the Waybar island.
    local isl; isl="$WB/islands/$(basename "$(layout_file)")"
    if [ "$(cstate_get island on)" = off ]; then
        "$WB/scripts/dynamic-island.sh" stop 2>/dev/null || true   # Settings → Island → off
    elif [ -f "$isl" ]; then
        if [ "$(cstate_get island_engine quickshell)" = quickshell ] && "$WB/scripts/dynamic-island.sh" start; then :
        else setsid -f "$SELF" _run island "$isl" "$style"; fi
    else
        "$WB/scripts/dynamic-island.sh" stop 2>/dev/null || true
    fi
    # Looks marked "// aether-dock: native" use the native macOS-style dock.
    if grep -qx '// aether-dock: native' "$(layout_file)"; then aether-dock run; else aether-dock stop; fi
}

# island_config FILE — write a self-contained copy of an island config (its
# includes merged in) whose module commands export the real session bus, and
# print its path. See `_run island` for why.
island_config() {
    local out="$CLASSIC_RUNTIME/island-config.json"
    python3 -I - "$1" "$out" "$DBUS_SESSION_BUS_ADDRESS" <<'PY' && echo "$out"
import json, os, re, shlex, sys

src, out, bus = sys.argv[1:4]

def load(path):
    text = open(os.path.expanduser(path)).read()
    text = re.sub(r"(?m)^\s*//.*$", "", text)       # full-line comments
    text = re.sub(r",(\s*[}\]])", r"\1", text)      # trailing commas
    return json.loads(text)

COMMANDS = ("exec", "exec-if", "on-click", "on-click-middle", "on-click-right",
            "on-double-click", "on-triple-click", "on-click-backward", "on-click-forward",
            "on-scroll-up", "on-scroll-down", "on-scroll-left", "on-scroll-right", "on-update")
prefix = "export DBUS_SESSION_BUS_ADDRESS=%s; " % shlex.quote(bus)

data = load(src)
bars = data if isinstance(data, list) else [data]
for bar in bars:
    inc = bar.pop("include", [])
    for path in [inc] if isinstance(inc, str) else inc:
        try:
            for k, v in load(path).items():
                bar.setdefault(k, v)
        except (OSError, ValueError):
            pass
    for v in bar.values():
        if isinstance(v, dict):
            for k in COMMANDS:
                if isinstance(v.get(k), str) and v[k]:
                    v[k] = prefix + v[k]
json.dump(data, open(out, "w"), indent=1)
PY
}

stop() {
    aether-dock stop 2>/dev/null || true
    [ -x "$WB/scripts/dynamic-island.sh" ] && "$WB/scripts/dynamic-island.sh" stop
    pkill -x waybar 2>/dev/null || true
    local _i; for _i in $(seq 1 20); do pgrep -x waybar >/dev/null || return 0; sleep 0.1; done
    pkill -9 -x waybar 2>/dev/null || true
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    toggle)
        if [ -s "$CLASSIC_RUNTIME/waybar-main.pid" ] && kill -0 "$(cat "$CLASSIC_RUNTIME/waybar-main.pid")" 2>/dev/null; then
            kill -USR1 "$(cat "$CLASSIC_RUNTIME/waybar-main.pid")"
        elif pgrep -x waybar >/dev/null; then pkill -SIGUSR1 -x waybar; else start; fi ;;
    _run)  # _run main|island CONFIG STYLE — record the PID, then become Waybar
        echo $$ > "$CLASSIC_RUNTIME/waybar-$2.pid"
        if [ "$2" = island ]; then
            rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/aether/island/visible"
            # Waybar is a single-instance GApplication: a second Waybar on the
            # same session bus forwards its command line to the first and one
            # of them aborts (g_application_impl_command_line: object_id != 0).
            # Without a session bus GLib runs it as an independent instance,
            # so the island gets none; its module commands get the real bus
            # back through a generated copy of its config.
            if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && island_cfg="$(island_config "$3")"; then
                DBUS_SESSION_BUS_ADDRESS="unix:path=/nonexistent" \
                    exec waybar -c "$island_cfg" -s "$4" >"$CLASSIC_RUNTIME/waybar-$2.log" 2>&1
            fi
        fi
        exec waybar -c "$3" -s "$4" >"$CLASSIC_RUNTIME/waybar-$2.log" 2>&1 ;;
    layouts) names layouts jsonc ;;
    styles) names styles css ;;
    layout|style)
        n="${2:-}"
        [[ "$n" =~ $NAME_RE ]] || { echo "usage: aether-waybar $1 NAME (see: aether-waybar ${1}s)" >&2; exit 2; }
        if [ "$1" = layout ]; then
            [ -f "$WB/layouts/$n.jsonc" ] || { echo "no layout $n" >&2; exit 1; }
            cstate_set waybar_layout "$n"
        else
            [ -f "$WB/styles/$n.css" ] || { echo "no style $n" >&2; exit 1; }
            aether-colors waybar-style "$n" --no-reload >/dev/null
        fi
        stop; start
        notify "Waybar" "$1: $n" preferences-desktop-theme -e -u low ;;
    *) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
