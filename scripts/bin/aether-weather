#!/usr/bin/bash
# aether-weather — weather for the Waybar module and the lock screen (wttr.in).
#
#   aether-weather            JSON for Waybar ({"text": …, "tooltip": …})
#   aether-weather --plain    one line, e.g. "  18°C"
#
# Location: state key weather_location (a city, "lat,lon" or empty for
# automatic). Units: weather_units = metric | us. Results are cached for 30
# minutes; offline, the last result is shown (marked stale) or nothing at all,
# so the module simply disappears instead of showing an error.

set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib/classic.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/classic.sh"

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/aether/weather.json"
LOC="$(cstate_get weather_location)"
UNITS="$(cstate_get weather_units metric)"
mkdir -p "$(dirname "$CACHE")"

if [ "$(cstate_get weather off)" = off ] && [ -z "$LOC" ] && [ "${1:-}" != --force ]; then
    # Weather is opt-in: it sends your (approximate) location to wttr.in.
    [ "${1:-}" = --plain ] || echo '{"text": ""}'
    exit 0
fi

stale=1
if [ -s "$CACHE" ] && [ $(( $(date +%s) - $(stat -c %Y "$CACHE") )) -lt 1800 ]; then
    stale=0
elif have curl; then
    loc_enc="$(python3 -I -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$LOC")"
    flag="m"; [ "$UNITS" = us ] && flag="u"
    if curl -fsS --max-time 8 "https://wttr.in/${loc_enc}?format=j1&${flag}" -o "$CACHE.tmp" 2>/dev/null \
        && python3 -I -c 'import json, sys; json.load(open(sys.argv[1]))' "$CACHE.tmp" 2>/dev/null; then
        mv "$CACHE.tmp" "$CACHE"; stale=0
    else
        rm -f "$CACHE.tmp"
    fi
fi

[ -s "$CACHE" ] || { [ "${1:-}" = --plain ] || echo '{"text": ""}'; exit 0; }

python3 -I - "$CACHE" "$UNITS" "$stale" "${1:-}" <<'PY'
import json, sys
path, units, stale, mode = sys.argv[1], sys.argv[2], sys.argv[3] == "1", sys.argv[4]
d = json.load(open(path))
cur = d["current_condition"][0]
code = int(cur.get("weatherCode", 113))
ICONS = [((113,), "󰖙"), ((116,), "󰖕"), ((119, 122), "󰖐"), ((143, 248, 260), "󰖑"),
         ((176, 263, 266, 293, 296, 353), "󰖗"), ((299, 302, 305, 308, 356, 359), "󰖖"),
         ((179, 182, 185, 227, 230, 323, 326, 329, 332, 335, 338, 368, 371, 374, 377), "󰖘"),
         ((200, 386, 389, 392, 395), "󰖓")]
icon = next((i for codes, i in ICONS if code in codes), "󰖐")
t = cur["temp_F"] + "°F" if units == "us" else cur["temp_C"] + "°C"
feels = cur["FeelsLikeF"] + "°F" if units == "us" else cur["FeelsLikeC"] + "°C"
desc = cur["weatherDesc"][0]["value"].strip()
area = d.get("nearest_area", [{}])[0]
place = ", ".join(x[0]["value"] for x in (area.get("areaName"), area.get("country")) if x)
if mode == "--plain":
    print("%s  %s" % (icon, t))
    sys.exit()
lines = ["<b>%s</b>" % place, "%s %s, feels like %s" % (icon, desc, feels),
         "Humidity %s%%  ·  Wind %s km/h" % (cur["humidity"], cur["windspeedKmph"])]
for day in d.get("weather", [])[:3]:
    hi = day["maxtempF"] if units == "us" else day["maxtempC"]
    lo = day["mintempF"] if units == "us" else day["mintempC"]
    lines.append("%s  %s° / %s°" % (day["date"], hi, lo))
if stale:
    lines.append("<i>offline — last update shown</i>")
print(json.dumps({"text": "%s %s" % (icon, t), "tooltip": "\n".join(lines), "class": "stale" if stale else "fresh"}, ensure_ascii=False))
PY
