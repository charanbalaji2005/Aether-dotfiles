[Unit]
Description=AetherOS desktop shell (Quickshell)
Documentation=https://github.com/charanbalaji2005/Aether-dotfiles
PartOf=graphical-session.target
After=graphical-session.target
# A broken shell must not spin the CPU: after 4 failed starts in 40 s systemd
# gives up on this unit and starts the safe-mode shell instead (OnFailure),
# so there is always a panel and a launcher on screen. `aether recover`
# explains what happened; `aether shell-reload` returns to the normal shell.
StartLimitIntervalSec=40
StartLimitBurst=4
OnFailure=aether-shell-safe.service
Conflicts=aether-shell-safe.service

[Service]
Type=simple
# systemd user units do not inherit the login shell's PATH. The shell runs
# helpers from ~/.local/bin (aether, aether-screenshot, ...), and Quickshell
# built from source installs to /usr/local/bin — both must be on PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env qs -c aether-shell
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
# The shell is an ordinary user program: it needs no new privileges.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
