[Unit]
Description=AetherOS Quickshell Desktop Environment Shell
Documentation=https://github.com/aetheros/aetheros-dotfiles
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c aether-shell
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
