[Unit]
Description=AetherOS Quickshell Desktop Environment Shell
Documentation=https://github.com/aetheros/aetheros-dotfiles
PartOf=graphical-session.target
After=graphical-session.target
# Stop restart loops if the QML is broken (5 failures in 30s), so a bad edit
# doesn't spin the CPU; `aether shell-reload` starts it again.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# systemd user units do not inherit the login shell's PATH. The shell runs
# helpers from ~/.local/bin (aether, aether-screenshot, ...), and Quickshell
# built from source installs to /usr/local/bin — both must be on PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env qs -c aether-shell
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
