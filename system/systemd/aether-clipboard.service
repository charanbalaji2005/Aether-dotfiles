[Unit]
Description=Clipboard history watcher (wl-paste -> cliphist)
Documentation=https://github.com/sentriz/cliphist
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# aether-clip-store skips secrets (password-manager hint) and excluded apps.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env wl-paste --watch aether-clip-store
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
