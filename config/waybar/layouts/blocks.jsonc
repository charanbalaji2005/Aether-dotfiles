// AetherOS look "Blocks": square, solid accent-coloured blocks — boxed
// numbered workspaces left, the date in the middle, readings in blocks right.
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces#boxes", "hyprland/window"],
    "modules-center": ["clock#stack", "custom/weather"],
    "modules-right": ["tray", "cpu#text", "temperature#text", "memory#text", "battery", "pulseaudio", "network", "custom/notification", "custom/power"]
}
