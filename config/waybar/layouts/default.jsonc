// AetherOS classic — "default": floating bar with everything (JaKooLit-class coverage).
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "reload_style_on_change": true,
    "modules-left": ["custom/menu", "hyprland/workspaces", "hyprland/window", "hyprland/submap"],
    "modules-center": ["clock", "custom/weather", "mpris"],
    "modules-right": ["tray", "group/hardware", "group/quick", "network", "bluetooth", "pulseaudio", "pulseaudio#mic", "backlight", "battery", "custom/cc", "custom/notification", "custom/power"]
}
