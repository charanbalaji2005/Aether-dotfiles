// AetherOS classic — "developer": resource meters and network throughput up front.
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "modules-left": ["custom/menu", "hyprland/workspaces#numbers", "hyprland/submap", "hyprland/window"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["cpu", "memory", "temperature", "disk", "network#speed", "network", "pulseaudio", "hyprland/language", "tray", "custom/notification", "custom/power"]
}
