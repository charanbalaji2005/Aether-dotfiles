// AetherOS classic — "laptop": battery, power profile, brightness and keep-awake in reach.
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "modules-left": ["custom/menu", "hyprland/workspaces", "mpris"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["tray", "idle_inhibitor", "power-profiles-daemon", "backlight", "network", "bluetooth", "pulseaudio", "battery", "custom/notification", "custom/power"]
}
