/* AetherOS classic — shared Rofi look. Colours are generated by aether-colors;
   the fallback below keeps Rofi usable before the first run. */
* {
    bg: #101218; bg-alt: #1a1c22; bg-sel: #2e3037; bg-glass: #101218eb;
    fg: #e4e7f0; fg-dim: #a3a6ae; fg-muted: #7a7c84; border-c: #3f4148;
    accent: #7f9cf5; accent2: #b48cf2; on-accent: #101218; urgent: #f2777a;
}
@import "~/.config/aether-shell/classic/colors/rofi.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}
window {
    background-color: @bg-glass;
    border: 1px;
    border-color: @border-c;
    border-radius: 18px;
    location: center;
    anchor: center;
}
mainbox { padding: 16px; spacing: 12px; }
inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; font: "JetBrainsMono Nerd Font Bold 11"; }
entry { placeholder: "Search…"; placeholder-color: @fg-muted; cursor: text; }
message { background-color: @bg-alt; border-radius: 10px; padding: 8px 12px; }
textbox { text-color: @fg-dim; }
listview { spacing: 4px; scrollbar: false; cycle: true; dynamic: true; fixed-height: false; }
element { padding: 8px 12px; border-radius: 10px; spacing: 12px; cursor: pointer; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.urgent { background-color: @urgent; text-color: @bg; }
element normal.active, element alternate.active { text-color: @accent2; }
element selected.active { background-color: @accent2; text-color: @on-accent; }
element-icon { size: 22px; background-color: transparent; text-color: inherit; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
mode-switcher { spacing: 8px; }
button { padding: 8px; border-radius: 10px; background-color: @bg-alt; text-color: @fg-dim; cursor: pointer; }
button selected { background-color: @accent; text-color: @on-accent; }
