/* AetherOS classic — "launchpad": full-screen app grid over the dimmed
   desktop, search on top (macOS Launchpad style). Hyprland animates it in
   (layer rule "popin" for the rofi namespace). */
@import "base.rasi"
/* width/height 100% instead of `fullscreen: true`, which Rofi's Wayland
   build does not honour reliably (the button then appeared to do nothing). */
window {
    width: 100%;
    height: 100%;
    location: center;
    anchor: center;
    background-color: rgba(0, 0, 0, 55%);
    border: 0;
    border-radius: 0;
}
mainbox { padding: 6% 12% 3% 12%; spacing: 30px; children: [ inputbar, listview, mode-switcher ]; background-color: transparent; }
inputbar {
    expand: false;
    width: 420px;
    margin: 0 30% 0 30%;
    border-radius: 14px;
    background-color: @bg-alt;
    padding: 10px 16px;
    children: [ entry ];
}
entry { placeholder: "Search"; horizontal-align: 0.5; }
listview { columns: 7; lines: 4; spacing: 26px; flow: horizontal; fixed-columns: true; scrollbar: false; background-color: transparent; }
element { orientation: vertical; padding: 14px 6px; spacing: 10px; border-radius: 22px; background-color: transparent; }
element selected.normal { background-color: rgba(255, 255, 255, 12%); text-color: @fg; }
element-icon { size: 72px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; font: "JetBrainsMono Nerd Font 10"; }
mode-switcher { expand: false; spacing: 12px; margin: 0 24% 0 24%; background-color: transparent; }
button { horizontal-align: 0.5; }
button { padding: 9px 18px; border-radius: 99px; background-color: rgba(255, 255, 255, 8%); text-color: @fg-dim; }
button selected { background-color: @accent; text-color: @on-accent; }
